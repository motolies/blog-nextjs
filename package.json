{
  "name": "blog-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -F blog dev",
    "build": "pnpm -F blog build",
    "start": "pnpm -F blog start",
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write",
    "verify": "pnpm check && pnpm typecheck && pnpm verify:tokens && pnpm test && pnpm test:blog && pnpm build",
    "test:blog": "pnpm -F blog test:util",
    "verify:tokens": "node scripts/verify-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "vitest": "catalog:"
  }
}
